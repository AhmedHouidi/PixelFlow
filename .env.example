# Gemini AI
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL
APP_URL="MY_APP_URL"

# remove.bg - keep this server-side in Netlify environment variables
REMOVE_BG_API_KEY="MY_REMOVE_BG_API_KEY"

# Google Firebase Authentication / Firestore
# These values come from Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Google AdSense
# Add these after your AdSense site is approved.
VITE_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"
VITE_ADSENSE_SLOT="XXXXXXXXXX"
